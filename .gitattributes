# Handle line endings automatically for files detected as text 
# and leave binary files untouched.
* text=auto

# Force LF for all source files (recommended for React/Web)
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.md      text eol=lf

# Force LF for shell scripts and Dockerfiles
*.sh text eol=lf
Dockerfile* text eol=lf

# Explicitly declare binary files (don't touch line endings)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.woff    binary
*.woff2   binary